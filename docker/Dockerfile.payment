FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY . .
RUN npx tsc -p tsconfig.payment.json

EXPOSE 3004

CMD ["npx", "nodemon", "--config", "nodemon.payment.json"]
