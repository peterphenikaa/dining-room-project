# Auth service only — copy to .env.auth and fill secrets
# compose: env_file [.env, .env.auth]

PORT=3003
AUTH_PORT=3003
AUTH_HOST_PORT=3003
DB_NAME=phongan_auth
AUTH_DB_NAME=phongan_auth

# Google OAuth (Auth sở hữu) — lấy từ Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/
GOOGLE_FAILURE_REDIRECT=http://localhost:5173/login
GOOGLE_LINK_SUCCESS_REDIRECT=http://localhost:5173/profile
GOOGLE_LINK_FAILURE_REDIRECT=http://localhost:5173/profile
